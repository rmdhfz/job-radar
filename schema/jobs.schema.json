{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jobs.schema.json",
  "title": "jobs.json: kontrak data antara pipeline dan portal",
  "type": "object",
  "required": ["generated_at", "jobs"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time", "description": "Waktu pipeline menghasilkan berkas ini (UTC)." },
    "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" } },
    "sources": { "type": "array", "description": "Opsional. Laporan cakupan per board/sumber dari run terakhir (PRD F-12).", "items": { "type": "object", "required": ["feed", "ok"], "properties": {
      "feed": { "type": "string" }, "company": { "type": "string" }, "ok": { "type": "boolean" }, "fetched": { "type": "integer" }, "kept": { "type": "integer" },
      "skipped": { "type": "object", "additionalProperties": { "type": "integer" } }, "error": { "type": "string" }, "fetched_at": { "type": "string", "format": "date-time" } } } },
    "companies": { "type": "object", "additionalProperties": { "$ref": "#/$defs/company" }, "description": "Opsional. Profil perusahaan; kuncinya sama persis dengan nilai 'company' di jobs. Hanya data perusahaan, bukan data pribadi." }
  },
  "$defs": {
    "job": {
      "type": "object",
      "required": ["id", "title", "company", "posted_at"],
      "properties": {
        "id": { "type": "string", "description": "Stabil antar-run (mis. hash dari company+url). Duplikat id dibuang oleh portal." },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "industry": { "type": "string", "description": "Dari taksonomi tetap di PRD.md." },
        "city": { "type": "string", "description": "Harus ada di gazetteer index.html, atau isi lat/lng, atau 'Remote'." },
        "province": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "level": { "type": "string" },
        "work_type": { "enum": ["onsite", "hybrid", "remote"], "default": "onsite" },
        "salary_min": { "type": ["number", "null"], "description": "Rupiah per bulan. null jika tidak tercantum. Jangan menebak." },
        "salary_max": { "type": ["number", "null"] },
        "posted_at": { "type": "string", "format": "date-time", "description": "Waktu posting di sumber. Jika sumber tidak menyebut, pakai waktu pertama kali terlihat dan tandai di source_label." },
        "last_verified_at": { "type": "string", "format": "date-time", "description": "Terakhir tautan lamar dicek masih hidup." },
        "status": { "enum": ["active", "unverified", "expired"], "default": "unverified" },
        "trust": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Skor kepercayaan, rubrik di PRD.md bagian 7." },
        "source_label": { "type": "string", "description": "Teks yang ditampilkan, mis. 'Situs perusahaan', 'Channel Telegram'." },
        "url": { "type": "string", "pattern": "^https?://", "description": "Tautan lamar resmi. Selain http(s) akan ditolak portal." },
        "summary": { "type": "string", "maxLength": 600, "description": "Opsional. Ringkasan singkat dari sumber, bukan salinan penuh deskripsi. Portal memotong di 600 karakter." }
      }
    },
    "company": {
      "type": "object",
      "properties": {
        "website": { "type": "string", "pattern": "^https?://", "description": "Situs resmi. Selain http(s) dibuang portal." },
        "industry": { "type": "string" },
        "founded": { "type": ["string", "integer"], "description": "Tahun atau tanggal berdiri, mis. 1991." },
        "headquarters": { "type": "string" },
        "employees": { "type": ["string", "integer"], "description": "Mis. '1.000–5.000'." },
        "ticker": { "type": "string", "description": "Kode saham, mis. 'TLKM'." },
        "summary": { "type": "string", "maxLength": 1200 },
        "history": { "type": "string", "maxLength": 2000, "description": "Sejarah singkat." },
        "source_label": { "type": "string", "description": "Asal profil, mis. 'Wikipedia', 'Situs perusahaan'." },
        "source_url": { "type": "string", "pattern": "^https?://" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
